{
  "name": "jurator",
  "version": "0.1.0",
  "description": "A linter for your company's promises: checks code changes against your written policies.",
  "keywords": ["policy", "compliance", "linter", "privacy", "security", "git-hooks", "coding-agents", "meta-muse"],
  "repository": { "type": "git", "url": "" },
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "engines": { "node": ">=22.12.0" },
  "bin": { "jurator": "dist/bin.js" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": { "zod": "4.6.7" },
  "devDependencies": { "@types/node": "26.6.6", "typescript": "7.0.2", "vitest": "5.0.5" }
}
